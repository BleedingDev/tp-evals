---
const normalizedBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const logoSrc = `${normalizedBase}assets/bleeding/blood-logo.svg`;
---

<footer
  class="text-[2svb] py-[1.5svb] px-[8svb] z-50 absolute inset-[auto_0_0_0] flex items-center gap-4 justify-between transition-colors duration-300 border-t"
  style="background-color: hsl(0 0% 4% / 0.95); border-color: hsl(356 88% 53% / 0.45);"
>
  <div class="flex items-center">
    <img
      src={logoSrc}
      alt="BleedingDev logo"
      width="44"
      height="44"
      class="drop-shadow-[0_0_14px_hsl(356_88%_53%_/0.45)]"
    />
  </div>
  <a href="https://bleeding.dev" class="text-white text-3xl" target="_blank"
    >bleeding.dev</a
  >
</footer>
