---
import Slide from "@bleedingdev/presentation-core/components/slide/Slide.astro";
import { highlightCode } from "@bleedingdev/presentation-core/utils/shiki-helper";
import type { DeckSlide } from "../content/slides";

interface Props extends DeckSlide {
  order: number;
}

const { order, title, eyebrow, hint, task, items = [], code, language, note, center } = Astro.props;
const highlightedCode = code ? await highlightCode(code, language ?? (code.includes("type ") ? "ts" : "bash")) : "";
---

{
  highlightedCode ? (
    <Slide title={title} desc={eyebrow} order={order} center={center}>
      <div slot="left" class:list={["space-y-[2.1svb]", center && "max-w-[100svb] mx-auto"]}>
        {hint && (
          <div class="space-y-[.45svb]">
            <p class="text-[1.9svb] font-bold uppercase text-theme-500">Kde hledat</p>
            <p set:html={hint} />
          </div>
        )}
        {task && (
          <div class="space-y-[.6svb]">
            <p class="text-[1.9svb] font-bold uppercase text-theme-500">Úkol teď</p>
            <p set:html={task} />
          </div>
        )}
        {items.length > 0 && (
          <ul class:list={[center && "inline-grid text-left"]}>
            {items.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        )}
        {note && <p class="text-gray-700" set:html={note} />}
      </div>
      <div slot="right" class="text-[2.2svb]" set:html={highlightedCode} />
    </Slide>
  ) : (
    <Slide title={title} desc={eyebrow} order={order} center={center}>
      <div slot="left" class:list={["space-y-[2.1svb]", center && "max-w-[100svb] mx-auto"]}>
        {hint && (
          <div class="space-y-[.45svb]">
            <p class="text-[1.9svb] font-bold uppercase text-theme-500">Kde hledat</p>
            <p set:html={hint} />
          </div>
        )}
        {task && (
          <div class="space-y-[.6svb]">
            <p class="text-[1.9svb] font-bold uppercase text-theme-500">Úkol teď</p>
            <p set:html={task} />
          </div>
        )}
        {items.length > 0 && (
          <ul class:list={[center && "inline-grid text-left"]}>
            {items.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        )}
        {note && <p class="text-gray-700" set:html={note} />}
      </div>
    </Slide>
  )
}
