---
import Footer from "@bleedingdev/presentation-core/components/footer/Footer.astro";
import Lava from "@bleedingdev/presentation-core/components/lava/Lava.astro";
import Progress from "@bleedingdev/presentation-core/components/progress/Progress.astro";
import ThemeToggle from "@bleedingdev/presentation-core/components/theme-toggle/ThemeToggle.astro";
import "@bleedingdev/presentation-core/styles/global.css";
import { slides } from "../content/slides";
import ContentSlide from "../slides/ContentSlide.astro";

const normalizedBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${normalizedBase}assets/bleeding/blood-logo.svg?v=2`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content="Astro" />
    <script is:inline>
      const theme = (() => {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "dark" || storedTheme === "light") return storedTheme;
        return "dark";
      })();

      const html = document.documentElement;
      html.classList.toggle("dark", theme === "dark");
      html.style.colorScheme = theme;
      localStorage.setItem("theme", theme);
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Unbounded:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Evalite QA Workshop | Evals</title>
    <meta name="description" content="Minimalistický workshop deck pro praktické evaluace AI výstupů v TypeScriptu a Evalite." />
    <meta name="author" content="Workshop" />
  </head>
  <body class="m-0 max-h-svh overflow-hidden transition-colors duration-300" style="background-color: var(--color-bg-primary);">
    <ThemeToggle />
    <div class="presentation max-h-svh relative">
      <Lava />
      <Progress />
      {slides.map((slide, index) => <ContentSlide {...slide} order={index + 1} />)}
    </div>
    <Footer />
  </body>
</html>
