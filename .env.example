WORKSHOP_MODE=live

EVALITE_DB_PATH=.evalite/evalite.db
EVALITE_RESULT_PATH=.evalite/results/latest.json
EVALITE_PORT=3006
EVALITE_SCORE_THRESHOLD=60
EVALITE_MAX_CONCURRENCY=4
EVALITE_TEST_TIMEOUT_MS=90000
EVALITE_TRIAL_COUNT=1
EVALITE_CACHE=true
EVALITE_HIDE_TABLE=false

LIVE_LLM_ENABLED=true
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=poolside/laguna-m.1:free,openai/gpt-oss-120b:free,openrouter/owl-alpha
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_API_KEY=
