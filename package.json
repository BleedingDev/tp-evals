{
  "name": "tp-evals-workshop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "start": "pnpm run smoke && pnpm run data:summary",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "smoke": "tsx scripts/smoke.ts",
    "live:check": "tsx scripts/live-model-smoke.ts",
    "docs:check": "tsx scripts/validate-workshop-docs.ts",
    "data:check": "tsx scripts/run-lab.ts data:check",
    "data:summary": "tsx scripts/run-lab.ts data:summary",
    "lab:01": "tsx scripts/run-lab.ts lab:01",
    "lab:02": "tsx scripts/run-lab.ts lab:02",
    "lab:03": "tsx scripts/run-lab.ts lab:03",
    "lab:04": "tsx scripts/run-lab.ts lab:04",
    "lab:05": "tsx scripts/run-lab.ts lab:05",
    "lab:06": "tsx scripts/run-lab.ts lab:06",
    "lab:07": "tsx scripts/run-lab.ts lab:07",
    "lab:08": "tsx scripts/run-lab.ts lab:08",
    "lab:09": "tsx scripts/run-lab.ts lab:09",
    "lab:10": "tsx scripts/run-lab.ts lab:10",
    "lab:11": "tsx scripts/run-lab.ts lab:11",
    "lab:all": "tsx scripts/run-lab.ts lab:all",
    "eval:dev": "tsx scripts/run-lab.ts eval:dev",
    "eval:all": "tsx scripts/run-lab.ts eval:all",
    "eval:export": "tsx scripts/run-lab.ts eval:export",
    "audit:mock": "tsx scripts/workshop-audit.ts mock",
    "audit:live-nojudge": "tsx scripts/workshop-audit.ts live-nojudge",
    "workshop:audit": "pnpm run typecheck && pnpm run docs:check && pnpm run data:check && pnpm run audit:mock",
    "verify": "pnpm run typecheck && pnpm run smoke && pnpm run live:check && pnpm run test && pnpm run data:check && pnpm run lab:all",
    "docker:build": "docker build -t tp-evals-workshop .",
    "docker:shell": "docker compose run --rm lab zsh",
    "docker:verify": "docker compose run --rm lab pnpm run verify",
    "docker:lab": "docker compose run --rm lab pnpm run lab:01"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "evalite": "1.0.0-beta.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "better-sqlite3": "12"
      }
    }
  }
}
